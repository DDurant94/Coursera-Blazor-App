@page "/not-found"
@layout MainLayout
@inject NavigationManager Navigation

<PageTitle>Page Not Found - EventEase</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="display-1 fw-bold text-primary mb-2">404</div>
            <h2 class="fw-bold mb-3">Page Not Found</h2>
            <p class="text-muted mb-4">
                The page you're looking for doesn't exist or the link may be incorrect.
                It may have been moved, renamed, or you may have followed a broken link.
            </p>
            <div class="d-flex gap-3 justify-content-center">
                <button class="btn btn-outline-secondary" @onclick="GoBack">
                    &larr; Go Back
                </button>
                <a href="events" class="btn btn-primary">Browse Events</a>
                <a href="" class="btn btn-outline-primary">Home</a>
            </div>
        </div>
    </div>
</div>

@code {
    private void GoBack() => Navigation.NavigateTo("javascript:history.back()");
}