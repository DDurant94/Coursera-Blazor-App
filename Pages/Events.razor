@page "/events"
@inject IEventService EventService
@inject IRegistrationService RegistrationService
@inject NavigationManager Navigation

<PageTitle>Events - EventEase</PageTitle>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold text-primary">Upcoming Events</h1>
            <p class="lead text-muted">Browse our upcoming corporate and social events. Click an event to view details and register.</p>
        </div>
    </div>

    @if (_events is null || !_events.Any())
    {
        <div class="alert alert-info">No events are currently available. Please check back soon.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var evt in _events)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm event-card" @onclick="() => NavigateToDetail(evt.Id)" style="cursor: pointer;">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-primary">@evt.Category</span>
                            <small>@evt.Date.ToString("MMM dd, yyyy")</small>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@evt.Name</h5>
                            <p class="card-text text-muted">
                                <span class="bi bi-geo-alt-fill me-1"></span>@evt.Location
                            </p>
                            <p class="card-text small text-secondary">
                                @(evt.Description.Length > 100 ? evt.Description[..100] + "..." : evt.Description)
                            </p>

                            @{
                                var registered = RegistrationService.GetRegistrationsForEvent(evt.Id).Count;
                                var available = evt.Capacity - registered;
                                var fillPercent = (int)((double)registered / evt.Capacity * 100);
                                var barColor = available == 0 ? "bg-danger" : fillPercent >= 75 ? "bg-warning" : "bg-success";
                            }
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">&#128100; @registered registered</span>
                                    <span class="@(available == 0 ? "text-danger fw-semibold" : "text-muted")">
                                        @(available == 0 ? "Fully Booked" : $"{available} spots left")
                                    </span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @barColor" role="progressbar"
                                         style="width: @fillPercent%"
                                         aria-valuenow="@fillPercent" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                            <small class="text-muted">Capacity: @evt.Capacity</small>
                            <button class="btn btn-sm btn-outline-primary" @onclick:stopPropagation="true" @onclick="() => NavigateToDetail(evt.Id)">
                                View Details
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<BlazorApp.Models.Event>? _events;

    protected override void OnInitialized()
    {
        _events = EventService.GetAllEvents();
    }

    private void NavigateToDetail(int eventId)
    {
        Navigation.NavigateTo($"/events/{eventId}");
    }
}
