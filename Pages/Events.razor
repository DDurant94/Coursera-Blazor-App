@page "/events"
@inject IEventService EventService
@inject IRegistrationService RegistrationService
@inject NavigationManager Navigation

<PageTitle>Events - EventEase</PageTitle>

<div class="container py-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-5 fw-bold text-primary">Upcoming Events</h1>
            <p class="lead text-muted">Browse our upcoming corporate and social events. Click an event to view details and register.</p>
        </div>
    </div>

    @if (_allEvents is null || !_allEvents.Any())
    {
        <div class="alert alert-info">No events are currently available. Please check back soon.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
            @foreach (var evt in _pagedEvents)
            {
                @* Safe stat lookup — falls back to zeros if the entry is missing *@
                var s = _stats.TryGetValue(evt.Id, out var stat) ? stat : default;

                @* Guard: truncate description safely even if it is null or empty *@
                var description = string.IsNullOrEmpty(evt.Description)
                    ? "No description available."
                    : evt.Description.Length > 100 ? evt.Description[..100] + "..." : evt.Description;

                <div class="col">
                    <div class="card h-100 shadow-sm event-card" @onclick="() => NavigateToDetail(evt.Id)" style="cursor: pointer;">
                        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                            <span class="badge bg-light text-primary">@(string.IsNullOrEmpty(evt.Category) ? "General" : evt.Category)</span>
                            <small>@evt.Date.ToString("MMM dd, yyyy")</small>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@(string.IsNullOrEmpty(evt.Name) ? "Unnamed Event" : evt.Name)</h5>
                            <p class="card-text text-muted">
                                <span class="bi bi-geo-alt-fill me-1"></span>
                                @(string.IsNullOrEmpty(evt.Location) ? "Location TBD" : evt.Location)
                            </p>
                            <p class="card-text small text-secondary">@description</p>
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">&#128100; @s.Registered registered</span>
                                    <span class="@(s.Available == 0 ? "text-danger fw-semibold" : "text-muted")">
                                        @(s.Available == 0 ? "Fully Booked" : $"{s.Available} spots left")
                                    </span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @s.BarColor" role="progressbar"
                                         style="width: @s.FillPercent%"
                                         aria-valuenow="@s.FillPercent" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                            <small class="text-muted">Capacity: @evt.Capacity</small>
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => NavigateToDetail(evt.Id)">
                                View Details
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Pagination controls *@
        @if (_totalPages > 1)
        {
            <nav aria-label="Event list pagination" class="d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    Showing @(_pageStart)–@(_pageEnd) of @_allEvents.Count events
                </small>
                <ul class="pagination mb-0">
                    <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="PreviousPage" disabled="@(_currentPage == 1)">
                            &laquo; Previous
                        </button>
                    </li>
                    @for (int p = 1; p <= _totalPages; p++)
                    {
                        var pageNum = p;
                        <li class="page-item @(_currentPage == pageNum ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(pageNum)">@pageNum</button>
                        </li>
                    }
                    <li class="page-item @(_currentPage == _totalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="NextPage" disabled="@(_currentPage == _totalPages)">
                            Next &raquo;
                        </button>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

@code {
    private List<BlazorApp.Models.Event>? _allEvents;
    private List<BlazorApp.Models.Event> _pagedEvents = new();

    private record struct EventStats(int Registered, int Available, int FillPercent, string BarColor);
    private Dictionary<int, EventStats> _stats = new();

    private const int PageSize = 6;
    private int _currentPage = 1;
    private int _totalPages = 1;
    private int _pageStart => (_currentPage - 1) * PageSize + 1;
    private int _pageEnd => Math.Min(_currentPage * PageSize, _allEvents?.Count ?? 0);

    protected override void OnInitialized()
    {
        _allEvents = EventService.GetAllEvents();

        // Precompute stats once — not recalculated on every render cycle.
        foreach (var evt in _allEvents)
        {
            var registered = RegistrationService.GetRegistrationCount(evt.Id);
            var available = evt.Capacity > 0 ? evt.Capacity - registered : 0;
            var fillPercent = evt.Capacity > 0 ? (int)((double)registered / evt.Capacity * 100) : 0;
            var barColor = available == 0 ? "bg-danger" : fillPercent >= 75 ? "bg-warning" : "bg-success";
            _stats[evt.Id] = new EventStats(registered, available, fillPercent, barColor);
        }

        _totalPages = (int)Math.Ceiling(_allEvents.Count / (double)PageSize);
        ApplyPage();
    }

    private void ApplyPage()
    {
        if (_allEvents is null) return;
        _pagedEvents = _allEvents
            .Skip((_currentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void GoToPage(int page)
    {
        // Guard: clamp page to valid range.
        _currentPage = Math.Clamp(page, 1, _totalPages);
        ApplyPage();
    }

    private void PreviousPage() => GoToPage(_currentPage - 1);
    private void NextPage() => GoToPage(_currentPage + 1);

    private void NavigateToDetail(int eventId)
    {
        Navigation.NavigateTo($"events/{eventId}");
    }
}
