@page "/"
@inject IEventService EventService
@inject NavigationManager Navigation

<PageTitle>Home - EventEase</PageTitle>

<div class="container py-5">
    <div class="row align-items-center mb-5">
        <div class="col-lg-7">
            <h1 class="display-4 fw-bold text-primary mb-3">Welcome to EventEase</h1>
            <p class="lead text-muted mb-4">
                Your all-in-one platform for discovering and registering for corporate and social events.
                Browse upcoming events, view details, and secure your spot — all in one place.
            </p>
              <p class="lead text-muted mb-4">
                GitHub Repo for this project is <a href="https://github.com/DDurant94/Coursera-Blazor-App">https://github.com/DDurant94/Coursera-Blazor-App</a> 
            </p>
            <div class="d-flex gap-3">
                <a href="events" class="btn btn-primary btn-lg px-4">Browse Events</a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-flex justify-content-center">
            <div class="text-center text-primary" style="font-size: 8rem; line-height: 1;">&#127882;</div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4">
                <div class="fs-1 mb-3">&#128269;</div>
                <h5 class="fw-bold">Discover Events</h5>
                <p class="text-muted small mb-0">Browse a curated list of upcoming corporate and social events with full details on date, location, and availability.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4">
                <div class="fs-1 mb-3">&#128203;</div>
                <h5 class="fw-bold">Easy Registration</h5>
                <p class="text-muted small mb-0">Register for any event in seconds. We validate your information and confirm your spot instantly.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center p-4">
                <div class="fs-1 mb-3">&#128200;</div>
                <h5 class="fw-bold">Live Availability</h5>
                <p class="text-muted small mb-0">See real-time seat availability for every event so you always know when to act fast.</p>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">Upcoming Events</h4>
        <a href="events" class="btn btn-sm btn-outline-primary">View All &rarr;</a>
    </div>
    <div class="row row-cols-1 row-cols-md-3 g-3">
        @foreach (var evt in _previewEvents)
        {
            <div class="col">
                <div class="card h-100 shadow-sm" style="cursor:pointer;" @onclick="() => NavigateToDetail(evt.Id)">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="badge bg-primary">@evt.Category</span>
                            <small class="text-muted">@evt.Date.ToString("MMM dd, yyyy")</small>
                        </div>
                        <h6 class="fw-bold mt-2">@evt.Name</h6>
                        <p class="text-muted small mb-0">&#128205; @evt.Location</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<BlazorApp.Models.Event> _previewEvents = new();

    protected override void OnInitialized()
    {
        // Show only the first 3 events as a preview — avoids loading all data on the home page.
        _previewEvents = EventService.GetAllEvents().Take(3).ToList();
    }

    private void NavigateToDetail(int id) => Navigation.NavigateTo($"events/{id}");
}
